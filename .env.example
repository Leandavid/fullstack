# Credenciales locales. Este archivo NO se sube a Git.
# Cópialo como .env y completa los valores desde Supabase:
# Project Settings → API → Project URL / anon key / service_role key.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=pega-aqui-la-anon-key
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# Opcional: puerto del servidor (3000 por defecto).
# PORT=3000
